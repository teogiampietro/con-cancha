@page "/panel/olvide"
@inherits CancellableComponentBase

<PageTitle>Recuperar contraseña · ConCancha</PageTitle>

<div class="landing">
    <form class="card col card-narrow" @onsubmit="() => SubmitAsync(ComponentToken)" @onsubmit:preventDefault>
        <h1>Recuperá tu contraseña</h1>
        @if (_isSent)
        {
            <p class="mut">Si ese mail tiene una cuenta, te mandamos un link para elegir una contraseña nueva. Revisá también el correo no deseado.</p>
            <a class="btn block" href="/panel/login">Volver a entrar</a>
        }
        else
        {
            <p class="mut">Poné el mail de tu cuenta y te mandamos un link.</p>
            <div>
                <label class="f" for="email">Mail</label>
                <input id="email" type="email" autocomplete="email" @bind="_email" @bind:event="oninput" required />
            </div>
            <ErrorMessage Message="@_errorMessage" />
            <button class="btn block" disabled="@_isBusy">@(_isBusy ? "Enviando…" : "Enviar el link")</button>
            <a class="lnk" href="/panel/login">Volver</a>
        }
    </form>
</div>
