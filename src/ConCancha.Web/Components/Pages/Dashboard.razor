@page "/panel"
@layout PanelLayout
@inherits PanelPageBase

<PageTitle>Panel · ConCancha</PageTitle>

<main class="panel">
    @if (_club is null)
    {
        <p class="loading">@(ErrorText ?? "Cargando…")</p>
    }
    else
    {
        <h1>Bienvenido a @_club.Name</h1>
        <p class="mut">Estás entrando como <b>@RoleLabel</b>.</p>

        <div class="card col">
            <b>Tu club</b>
            <div class="mut">Link de reservas: <a class="acc" href="@PageRoutes.PublicClub(_club.Slug)" target="_blank" rel="noopener">@PublicSite.Domain/@_club.Slug</a></div>
            <div class="mut">Horario: de @DisplayFormat.Time(_club.OpeningMinuteOfDay) a @DisplayFormat.Time(_club.ClosingMinuteOfDay)</div>
            @if (!string.IsNullOrEmpty(_club.Phone)) { <div class="mut">Teléfono: @_club.Phone</div> }
        </div>

        <div class="card col">
            <b>Primeros pasos</b>
            <div class="row"><span class="chip ok">✓</span> Creaste tu club</div>
            <div class="row"><span class="chip ok">✓</span> Cargaste tus canchas y precios</div>
            <div class="row"><span class="chip">•</span> <a href="@PageRoutes.Agenda">Cargá tu primer turno en la agenda</a></div>
        </div>

        @if (_team is not null)
        {
            <div class="card col">
                <b>Equipo</b>
                @foreach (var member in _team)
                {
                    <div class="row sp"><span>@member.Email</span><span class="chip">@RoleLabelOf(member.Role)</span></div>
                }
            </div>
        }
    }
</main>
