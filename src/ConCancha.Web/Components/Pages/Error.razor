@page "/Error"

<PageTitle>Error · ConCancha</PageTitle>

<div class="landing">
    <div class="card col">
        <h1>Algo salió mal</h1>
        <p class="mut">Ya lo estamos viendo. Probá de nuevo en un momento.</p>
        @if (!string.IsNullOrEmpty(RequestId))
        {
            <p class="xs">Código: @RequestId</p>
        }
        <a class="btn block" href="/">Ir al inicio</a>
    </div>
</div>
