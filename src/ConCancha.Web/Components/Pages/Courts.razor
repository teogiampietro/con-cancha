@page "/panel/canchas"
@layout PanelLayout
@inherits PanelPageBase

<PageTitle>Canchas · ConCancha</PageTitle>

<main class="panel">
    <h1>Canchas</h1>

    @if (_club is null || _courts is null)
    {
        <p class="loading">@(ErrorText ?? "Cargando…")</p>
    }
    else
    {
        <div class="seg">
            <button class="@(_tab == CourtsTab.Courts ? "on" : "")" @onclick="() => _tab = CourtsTab.Courts">Canchas</button>
            <button class="@(_tab == CourtsTab.Recurring ? "on" : "")" @onclick="() => _tab = CourtsTab.Recurring">Turnos fijos</button>
        </div>
    }

    @if (_club is not null && _courts is not null && _tab == CourtsTab.Recurring)
    {
        <RecurringGrid Courts="ActiveCourts"
                       ClubOpeningMinuteOfDay="_club.OpeningMinuteOfDay" ClubClosingMinuteOfDay="_club.ClosingMinuteOfDay" />
    }
    else if (_club is not null && _courts is not null)
    {
        <ClubHoursCard OpeningMinuteOfDay="_club.OpeningMinuteOfDay" ClosingMinuteOfDay="_club.ClosingMinuteOfDay" OnSaved="OnHoursSaved" />

        @foreach (var court in _courts)
        {
            @if (_editingCourtId == court.Id)
            {
                <CourtForm Court="court" ClubOpeningMinuteOfDay="_club.OpeningMinuteOfDay" ClubClosingMinuteOfDay="_club.ClosingMinuteOfDay"
                           OnSaved="OnCourtSaved" OnCancel="CloseCourtForm" />
            }
            else
            {
                <div class="card col @(court.IsActive ? "" : "off")">
                    <div class="row sp">
                        <span>
                            <b>@court.Name</b> <span class="chip">@SportLabels.Get(court.Sport)</span>
                            @if (!court.IsActive) { <span class="chip">Desactivada</span> }
                            <div class="mut sm">Turnos de @court.SlotMinutes min · @DescribeHours(court)</div>
                        </span>
                        <span class="row">
                            <button class="lnk" @onclick="() => EditCourt(court)">Editar</button>
                            <button class="lnk" @onclick="() => TogglePrices(court)">@(_pricesCourtId == court.Id ? "Ocultar precios" : "Precios")</button>
                        </span>
                    </div>
                    @if (_pricesCourtId == court.Id)
                    {
                        <PriceRulesEditor CourtId="court.Id" />
                    }
                </div>
            }
        }

        @if (_isCreating)
        {
            <CourtForm ClubOpeningMinuteOfDay="_club.OpeningMinuteOfDay" ClubClosingMinuteOfDay="_club.ClosingMinuteOfDay"
                       OnSaved="OnCourtSaved" OnCancel="CloseCourtForm" />
        }
        else
        {
            <button class="btn" @onclick="StartCreating">Agregar cancha</button>
        }
    }
</main>
