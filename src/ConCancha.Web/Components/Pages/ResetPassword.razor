@page "/panel/restablecer"
@inherits CancellableComponentBase

<PageTitle>Contraseña nueva · ConCancha</PageTitle>

<div class="landing">
    <form class="card col card-narrow" @onsubmit="() => SubmitAsync(ComponentToken)" @onsubmit:preventDefault>
        <h1>Elegí una contraseña nueva</h1>
        @if (_isDone)
        {
            <p class="mut">Listo, ya podés entrar con tu contraseña nueva.</p>
            <a class="btn block" href="/panel/login">Entrar</a>
        }
        else if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            <p class="mut">Este link está incompleto. Pedí uno nuevo.</p>
            <a class="btn block" href="/panel/olvide">Pedir otro link</a>
        }
        else
        {
            <p class="mut">Para la cuenta <b>@Email</b>.</p>
            <div>
                <label class="f" for="password">Contraseña nueva</label>
                <input id="password" type="password" autocomplete="new-password" @bind="_newPassword" @bind:event="oninput" required />
                <p class="hint">Mínimo @AccountLimits.PasswordMinLength letras o números.</p>
            </div>
            <ErrorMessage Message="@_errorMessage" />
            <button class="btn block" disabled="@_isBusy">@(_isBusy ? "Guardando…" : "Guardar")</button>
        }
    </form>
</div>
