<header class="panel-header no-print">
    <b>ConCancha</b>
    <nav class="row nav">
        <NavLink href="@PageRoutes.Agenda" ActiveClass="on">Agenda</NavLink>
        <NavLink href="@PageRoutes.Reservations" ActiveClass="on">Reservas</NavLink>
        <NavLink href="@PageRoutes.Reminders" ActiveClass="on">Recordar</NavLink>
        <NavLink href="@PageRoutes.Cash" ActiveClass="on">Caja</NavLink>
        <NavLink href="@PageRoutes.Customers" ActiveClass="on">Clientes</NavLink>
        @if (IsOwner)
        {
            <NavLink href="@PageRoutes.Courts" ActiveClass="on">Canchas</NavLink>
        }
    </nav>
    <span class="row">
        <span class="mut sm hide-narrow">@Session.Current?.User.Email</span>
        <button class="lnk" @onclick="() => OnSignOut.InvokeAsync()">Salir</button>
    </span>
</header>
