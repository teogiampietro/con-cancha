@inherits CancellableComponentBase

<form class="card col" @onsubmit="() => SaveAsync(ComponentToken)" @onsubmit:preventDefault>
    <b>Tu cuenta</b>
    <p class="mut sm no-margin">Cambiá la contraseña con la que entrás al panel.</p>
    <div>
        <label class="f" for="current-password">Contraseña actual</label>
        <input id="current-password" type="password" autocomplete="current-password" @bind="_currentPassword" @bind:event="oninput" required />
        <FieldError Message="@_currentError" />
    </div>
    <div>
        <label class="f" for="new-password">Contraseña nueva</label>
        <input id="new-password" type="password" autocomplete="new-password" @bind="_newPassword" @bind:event="oninput" required />
        <p class="hint">Mínimo @AccountLimits.PasswordMinLength letras o números.</p>
        <FieldError Message="@_newError" />
    </div>
    <div>
        <label class="f" for="repeat-password">Repetir la nueva</label>
        <input id="repeat-password" type="password" autocomplete="new-password" @bind="_repeatedPassword" @bind:event="oninput" required />
        <FieldError Message="@_repeatError" />
    </div>
    <ErrorMessage Message="@_errorMessage" />
    @if (_isSaved) { <p class="sm success no-margin">Listo, ya podés usar tu contraseña nueva.</p> }
    <button class="btn" disabled="@_isBusy">@(_isBusy ? "Guardando…" : "Cambiar contraseña")</button>
</form>
